# FinSage Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME="FinSage API"
API_V1_STR="/api/v1"

# PostgreSQL Database Connection URL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finsage_db

# JWT Authentication (Legacy & Fallback)
JWT_SECRET_KEY=finsage_super_secret_jwt_key_change_in_production_9f83b27e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clerk Authentication (FastAPI Verification & Webhooks)
# Frontend tokens are verified via Clerk JWKS: https://<your-domain>.clerk.accounts.dev
CLERK_ISSUER_URL=https://your-app-domain.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SECRET

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://localhost:3000,https://ai-finsage.vercel.app"
