# FinSage Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME="FinSage API"
API_V1_STR="/api/v1"

# PostgreSQL Database Connection URL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finsage_db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://localhost:3000,https://ai-finsage.vercel.app"
