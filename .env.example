# ==============================================================================
# FinSage Unified Environment Variables Template (.env.example)
# ==============================================================================
# DO NOT put real secrets in this file. Copy to .env and fill with real values.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
APP_NAME="FinSage API"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Production Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Examples:
# - Neon: postgresql+psycopg://user:pass@ep-cool-pool.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Supabase: postgresql+psycopg://postgres.project:pass@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:your_db_password@your_cloud_host:5432/finsage_prod?sslmode=require

# ------------------------------------------------------------------------------
# 3. CLERK AUTHENTICATION (Production or Development)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (used by Frontend and as backend fallback):
# In Production: starts with pk_live_
# In Development: starts with pk_test_
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY

# Clerk Backend Secret Key:
# In Production: starts with sk_live_
# In Development: starts with sk_test_
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY

# Clerk Issuer URL (Frontend API URL for JWKS RS256 token verification):
# Standard Clerk Domain: https://clerk.yourdomain.com OR https://<your-instance>.clerk.accounts.dev
CLERK_ISSUER_URL=https://clerk.yourdomain.com

# Clerk Webhook Signing Secret (Optional, for user event synchronization):
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SIGNING_SECRET

# ------------------------------------------------------------------------------
# 4. JWT & FALLBACK AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# In Production, JWT_SECRET_KEY must be a random string >= 32 characters long.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_random_32_plus_character_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. CORS ORIGINS (Strict Production Whitelist)
# ------------------------------------------------------------------------------
# Comma-separated list of exact allowed frontend origins (NO trailing slashes)
CORS_ORIGINS="https://ai-finsage.vercel.app,https://frontend-omega-lake-79.vercel.app"

# ------------------------------------------------------------------------------
# 6. FRONTEND API BASE URL (Optional / Vercel Serverless)
# ------------------------------------------------------------------------------
# Defaults to /api/v1 (relative rewrite in Vercel). Specify if using separate backend domain.
VITE_API_BASE_URL=/api/v1
VITE_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 7. AI COPILOT & LLM SETTINGS (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 8. CRON & MAINTENANCE SECURITY (Optional)
# ------------------------------------------------------------------------------
CRON_SECRET=your_secure_cron_maintenance_secret_token_here
